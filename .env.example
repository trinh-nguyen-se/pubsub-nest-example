# ---- hạ tầng local (docker compose) ----
DATABASE_URL=postgres://demo:demo@localhost:45432/cms
REDIS_URL=redis://localhost:46379

# ---- CMS (producer) ----
CMS_PORT=3001
ADMIN_TOKEN=admin-dev-token
# advisory = khoá advisory lúc ghi: commit order = seq order (mặc định, đúng)
# none  = cursor seq trơn, CỐ TÌNH sai — dùng cho bài lab

FENCE_STRATEGY=advisory
PUBLISH_ADAPTER=redis
PUBLISH_INTERVAL_MS=250
# giữ sync_change bao lâu (ngày) — consumer tụt quá hạn thì full resync
CHANGE_RETENTION_DAYS=30
GRAPHQL_INTROSPECTION=true

# ---- token máy-với-máy, mỗi consumer một token ----
B2B_TOKEN=b2b-dev-token
B2C_TOKEN=b2c-dev-token

# ---- consumer ----
CONSUMER_B2B_PORT=3002
CONSUMER_B2C_PORT=3003
RECONCILE_INTERVAL_MS=1500
# mô phỏng mất message: đặt 1 để consumer bỏ qua toàn bộ message, chỉ bù bằng changes()
DROP_MESSAGES=0
CMS_GRAPHQL_URL=http://localhost:3001
